# ─────────────────────────────────────────────────────────────
# Environment variables for the Meta Ad Library Scraper.
# Copy this file to .env and fill in your keys:   cp .env.example .env
# On Replit, set these in the "Secrets" tab instead of a .env file.
# The real .env is gitignored; this template is safe to commit.
# ─────────────────────────────────────────────────────────────

# ---- Optional ----
# Port the server listens on. Replit injects PORT automatically;
# locally it falls back to 3001 if unset.
PORT=3001

# ---- Required for scraping ----
# Apify API token — powers Meta Ad Library scraping.
# Without it, scrape endpoints return a "not configured" error.
# Get one at: https://console.apify.com/account/integrations
APIFY_TOKEN=

# ---- Required for AI analysis ----
# Google Gemini API key — powers AI ad-creative analysis.
# Without it, the analyze endpoint returns a "not configured" error.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
